{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PagePackage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "url",
    "content",
    "internal_links",
    "schema",
    "qa"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "canonical": {
          "type": "string"
        },
        "robots": {
          "type": "string"
        },
        "og_title": {
          "type": "string"
        },
        "og_description": {
          "type": "string"
        },
        "og_image": {
          "type": "string"
        }
      }
    },
    "url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "breadcrumbs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1",
        "sections",
        "body"
      ],
      "properties": {
        "h1": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "heading",
              "intent",
              "key_points",
              "internal_links",
              "ctas"
            ],
            "properties": {
              "id": { "type": "string" },
              "heading": { "type": "string" },
              "intent": { "type": "string" },
              "key_points": {
                "type": "array",
                "items": { "type": "string" }
              },
              "internal_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "url"],
                  "properties": {
                    "label": { "type": "string" },
                    "url": { "type": "string" }
                  }
                }
              },
              "ctas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "url", "variant", "position"],
                  "properties": {
                    "label": { "type": "string" },
                    "url": { "type": "string" },
                    "variant": { "type": "string" },
                    "position": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "body": {
          "type": "string"
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer", "schema_include"],
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" },
              "schema_include": { "type": "boolean" }
            }
          }
        },
        "ctas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url", "variant", "position"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" },
              "variant": { "type": "string" },
              "position": { "type": "string" }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "alt"],
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string" },
              "title": { "type": "string" },
              "width": { "type": "number" },
              "height": { "type": "number" },
              "caption": { "type": "string" }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "columns", "rows"],
            "properties": {
              "title": { "type": "string" },
              "columns": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "internal_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outbound"
      ],
      "properties": {
        "outbound": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_context", "label", "url", "type", "reason"],
            "properties": {
              "source_context": { "type": "string" },
              "label": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "inbound_suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from_page_id": { "type": "string" },
              "from_url": { "type": "string" },
              "suggested_anchor": { "type": "string" },
              "target_url": { "type": "string" },
              "reason": { "type": "string" }
            },
            "anyOf": [
              { "type": "object", "additionalProperties": false, "required": ["from_page_id"] },
              { "type": "object", "additionalProperties": false, "required": ["from_url"] }
            ],
            "required": ["suggested_anchor", "target_url", "reason"]
          }
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonld"
      ],
      "properties": {
        "jsonld": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fail_rules",
        "warn_rules",
        "fix_list",
        "completeness_score"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "WARN",
            "BLOCK",
            "NEEDS_INPUT"
          ]
        },
        "fail_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warn_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fix_list": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "completeness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "checks_run": {
          "type": "number",
          "minimum": 0
        },
        "rule_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
